{
	"schemaVersion": 1,
	"id": "bundle-scroller",
	"version": "${version}",
	"name": "Bundle Scroller",
	"description": "Drag a bundle across inventory slots: left-drag fills the bundle from filled slots, right-drag spreads its items one at a time into empty slots.",
	"authors": [
		"MGThorn"
	],
	"contact": {
		"homepage": "https://github.com/MGThorn/bundle-scroller",
		"sources": "https://github.com/MGThorn/bundle-scroller",
		"issues": "https://github.com/MGThorn/bundle-scroller/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/bundle-scroller/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.mgthorn.bundlescroller.client.BundleScrollerClient"
		]
	},
	"mixins": [
		{
			"config": "bundle-scroller.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"malilib": ">=0.27.20",
		"itemscroller": ">=0.30.8"
	}
}
